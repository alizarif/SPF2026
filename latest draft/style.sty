% Customization for non-bold section titles using titlesec
% aka, Sophia is crazy
%
%##############
\usepackage{titlesec}
\titleformat{\section}{\normalfont\Large}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\large}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalfont\normalsize}{\thesubsubsection}{1em}{}

\makeatletter
\renewcommand\AB@maketitle{%
  \null
  \begin{center}%
    {\normalfont\LARGE \@title \par}%
    \vskip 1.5em%
    {\normalfont\large \@author \par}%
    \vskip 1em%
    {\normalfont\large \@date}%
  \end{center}%
  \par\vskip 1.5em}
\makeatother
